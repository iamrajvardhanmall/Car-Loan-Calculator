# =================================================================
# Git Ignore Rules for CarLoan Microservices Project
# =================================================================

# 1. Environment & Secret Configuration Files (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
*.env
local_settings.py
secrets.yaml
*-secrets.yaml

# 2. Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Django Runtime & Database
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# 5. Testing & Code Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# 6. IDEs & Operating System Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 7. Terraform State & Variables
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log

# 8. Local Documentation & Notes
PROJECT_OVERVIEW.md
DEVOPS_MICROSERVICES_GUIDE.md
KUBERNETES_DEPLOYMENT_GUIDE.md
RENDER_DEPLOYMENT_GUIDE.md
docker.txt
kubernetes.txt
terraform.txt
prometheus.txt
webhooks.txt
grafana.txt
DEVOPS_COMPLETE_GUIDE.txt
PROJECT_SYNOPSIS.txt
PROJECT_SYNOPSIS.html
*.txt
