# =================================================================
# Docker Ignore Rules for Root and Microservices
# =================================================================

# Version control & Config
.git/
.gitignore
.dockerignore
.gitattributes

# Secrets & Environment variables
.env
.env.*
!.env.example
*.env
local_settings.py

# Python cache & bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Databases & local storage
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation, Terraform, and K8s manifests
*.md
*.txt
*.html
terraform/
k8s/
monitoring/
load_test.py
webhook_server.py
.idea/
.vscode/
.DS_Store
Thumbs.db
