# =================================================================
# CarLoan Microservices - Complete Environment Configuration Example
# =================================================================

# 1. Django Web Application Settings
SECRET_KEY=django-insecure-carloan-change-this-in-production
DEBUG=True

# Allowed Hosts & CSRF Origins (Comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost,web_app,0.0.0.0,.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.onrender.com

# 2. Database Configuration
# Cloud Deployment (Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/car_loan_db
DATABASE_URL=

# Local / Docker PostgreSQL:
DB_NAME=Car_Loan
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=postgres_db
DB_PORT=5432

# 3. Google Gemini AI API (Used for Vehicle Valuation)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# 4. Microservice Endpoints
# Docker Compose: http://valuation_service:5001/api/estimate
# Render Microservices: https://<ai-service>.onrender.com/api/estimate
# If empty, Django automatically uses its built-in local engine!
VALUATION_SERVICE_URL=http://valuation_service:5001/api/estimate
PDF_SERVICE_URL=http://pdf_service:5002/api/generate-pdf

# 5. Google OAuth2 Social Authentication (Optional)
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
# Local: http://127.0.0.1:8000/social-auth/complete/google-oauth2/
# Render: https://<your-web-service>.onrender.com/social-auth/complete/google-oauth2/
SOCIAL_AUTH_GOOGLE_OAUTH2_REDIRECT_URI=http://127.0.0.1:8000/social-auth/complete/google-oauth2/
