# =================================================================
# Docker Microservices Environment Configuration
# =================================================================

# Django Settings
SECRET_KEY=django-insecure-carloan-change-this-in-production
DEBUG=True

# PostgreSQL Database Configuration
DB_NAME=Car_Loan
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=postgres_db
DB_PORT=5432

# Google Gemini API (Used by AI Valuation Microservice)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Microservice Endpoints (Internal Docker Network)
VALUATION_SERVICE_URL=http://valuation_service:5001/api/estimate
PDF_SERVICE_URL=http://pdf_service:5002/api/generate-pdf

# Google OAuth2 Authentication (Optional)
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
