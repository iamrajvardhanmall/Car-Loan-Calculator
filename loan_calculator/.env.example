# =================================================================
# Django Loan Calculator - Environment Configuration Example
# =================================================================

# Security Settings
# Generate a secret key or use a random string in production
SECRET_KEY=django-insecure-change-this-in-production
# Set DEBUG=False in production (Render)
DEBUG=True

# Allowed Hosts & CSRF Origins (Comma-separated)
# In production on Render: ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,.onrender.com
# In production on Render: CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.onrender.com

# Database Configuration:
# Option A (Cloud / Render): Provide full connection URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Option B (Localhost / Docker): Provide individual credentials
DB_NAME=Car_Loan
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=127.0.0.1
DB_PORT=5432

# Google Gemini AI API Key (Used for Vehicle Valuation)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Microservices URLs (Optional - Fallbacks to local engines if empty)
VALUATION_SERVICE_URL=
PDF_SERVICE_URL=

# Google OAuth2 Authentication (Optional)
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
# Local: http://127.0.0.1:8000/social-auth/complete/google-oauth2/
# Render: https://<your-service>.onrender.com/social-auth/complete/google-oauth2/
SOCIAL_AUTH_GOOGLE_OAUTH2_REDIRECT_URI=http://127.0.0.1:8000/social-auth/complete/google-oauth2/
